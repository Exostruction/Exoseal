# Kopieren nach .env und Werte setzen.
POSTGRES_DB=exoseal
POSTGRES_USER=exoseal
POSTGRES_PASSWORD=change-me
FRONTEND_PORT=3000

# Version der fertigen Images (ghcr.io/exostruction/exoseal-backend und -frontend). latest = neueste; für Produktion besser eine feste Version, z. B. 1.0.0.
EXOSEAL_VERSION=1.0.0

# Öffentliche Adresse (ohne /api/v1), wird für die OIDC-Redirect-URI genutzt.
# Redirect-URI beim Anbieter eintragen: <PUBLIC_URL>/api/v1/auth/callback
PUBLIC_URL=http://localhost:3000

# OIDC-Login (leer = Login deaktiviert). Beliebiger OIDC-Anbieter mit PKCE S256.
OIDC_METADATA_ADDRESS=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# Allowlist, Komma-getrennt. Mindestens eins setzen, sobald Login aktiv ist.
ALLOWED_EMAIL_DOMAINS=example.com
ALLOWED_EMAILS=

# Rate-Limit pro Besucher: Wie viele Reverse-Proxys (nginx, Caddy, Traefik) sitzen vor dem Frontend und hängen
# die Client-IP an X-Forwarded-For? Next.js selbst fügt nichts hinzu.
#   0 = ohne Proxy (Entwicklung). Header wird ignoriert, alle Besucher teilen sich ein Limit.
#   1 = ein Reverse-Proxy davor (Produktion). Höher nur, wenn es wirklich mehr Hops sind: sonst per Header umgehbar.
#   2 = Cloudflare, dann Traefik, dann Frontend (unsere Instanz). Traefik darf dafür nur die Cloudflare-Adressen als vertrauenswürdig führen.
TRUSTED_PROXY_HOPS=0
# Alternative zu den Hops, wenn der Server nur über einen Proxy erreichbar ist, der die echte IP in einen eigenen Header schreibt
# (Cloudflare: CF-Connecting-IP). Nicht zusammen mit TRUSTED_PROXY_HOPS > 0 setzen, sonst startet das Backend nicht.
CLIENT_IP_HEADER=

# Kontakt für Missbrauchsmeldungen (wird auf der Melde-Seite angezeigt, leer = nicht anzeigen).
ABUSE_EMAIL=

# Benachrichtigung, wenn auf eine Anfrage geantwortet wurde. Beides optional, nie mit Inhalt (nur "Antwort eingegangen" + Link).
# Mail (SMTP, STARTTLS oder SSL wird automatisch gewählt). Leer = aus.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Webhook (POST, JSON, HMAC-SHA256-signiert). Leer = aus. Secret mindestens 16 Zeichen.
WEBHOOK_URL=
WEBHOOK_SECRET=

# Impressum (Seite /imprint). Leer = Hinweis, dass noch nichts hinterlegt ist. Mehrzeilige Anschrift mit 
.
# Dienstleister vor der Instanz, erscheinen in der Datenschutzerklärung (Komma-getrennt): cloudflare, crowdsec, crowdsecshare (= CrowdSec mit Community-Teilen)
PRIVACY_SERVICES=
# Zeigt auf der Startseite die neuesten Beiträge des Exostruction-Blogs der Kategorie BLOG_CATEGORY (Standard ExoSeal). Der Abruf läuft auf dem Server, Besucher kontaktieren die Blog-Seite nie.
BLOG_ENABLED=
BLOG_CATEGORY=
# Meldet die öffentlichen Seiten beim Start an IndexNow (Bing, Yandex u. a.): true = an, leer = aus. Nur bei https und nicht für localhost.
INDEXNOW=
IMPRINT_NAME=
IMPRINT_ADDRESS=
IMPRINT_EMAIL=
# Pflichtangaben nach § 5 DDG für Unternehmen (leer lassen, was nicht zutrifft)
IMPRINT_REPRESENTED_BY=
IMPRINT_PHONE=
IMPRINT_REGISTER=
IMPRINT_VAT_ID=

# Optional: Link mit Sternen auf der Startseite (die Zahl holt der Server, nie der Browser). Leer = Exostruction/Exoseal, "besitzer/repo" = dein Fork, "off" = kein Link und keine Abfrage.
GITHUB_REPO=
